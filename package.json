{
  "name": "alyans-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && astro build",
    "build:staging": "SITE_ENV=staging npm run build",
    "build:production": "SITE_ENV=production npm run build",
    "deploy:staging": "npm run build:staging && rsync -a --delete dist/ /var/www/alyans/staging-dist/",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "manual:scroll-360": "node scripts/check-scroll-360.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "20.19.43",
    "astro": "5.18.2",
    "eslint": "10.10.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}

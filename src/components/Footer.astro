---
import { getEntry } from 'astro:content';

const rekvizity = await getEntry('rekvizity', 'rekvizity');
if (!rekvizity) {
  throw new Error('Запись реквизитов не найдена — подвал не может собраться без неё');
}
const r = rekvizity.data;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>{r.naimenovanieKratkoe}</span>
    <span class="mono">ИНН {r.inn}</span>
    <span class="mono">ОГРН {r.ogrn}</span>
    <span>юридический адрес: {r.yuridicheskiyAdres}</span>
    <span class="mono">2026</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--on-dark-2);
  }

  .site-footer__inner {
    padding: 16px var(--content-padding, 28px);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.7;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
  }

  .site-footer__inner span:not(:last-child)::after {
    content: ' ·';
    margin-left: 10px;
  }

  @media (max-width: 767px) {
    .site-footer__inner {
      flex-direction: column;
      gap: 4px;
    }
    .site-footer__inner span::after {
      content: none !important;
    }
  }
</style>
